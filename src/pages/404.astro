---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not Found – Tormont 50" bodyClass="page-wrapper full-page-section">
  <div class="utility-page-wrap not-found">
    <div class="utility-page-content w-form">
      <div class="container-default w-container">
        <div class="text-center mg-bottom-48px">
          <div class="display-1 color-neutral-800 mg-bottom-16px">404</div>
          <div class="max-w-460px center">
            <h1 class="display-3">The page you’re looking for is no longer available</h1>
          </div>
          <div class="mg-top-24px">
            <a href="/" class="btn-primary w-button">
              Go back home<span class="line-rounded-icon link-icon-right">&#xe805;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="floating-item shape-404---01 reveal-on-scroll">
      <div class="shape _02"></div>
    </div>
    <div class="floating-item shape-404---02 reveal-on-scroll">
      <div class="shape _07"><div class="circle-shape"></div></div>
    </div>
    <div class="floating-item shape-404---03 reveal-on-scroll">
      <div class="shape _11"></div>
    </div>
  </div>
</Layout>
