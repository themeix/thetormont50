lazy" src="/images/68ca49bc4f6c9ca565798475_reliq.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bcc2c2778b87be72c4_cb2.jpg"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bc4f1b049e5eeb391a_Lucky-Logo.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bc29551a381db81499_Csnnex.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bc1b804dd38886f668_PyroGenesis.jpg"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bc4085eb2872db821e_EMGOLD.jpg"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bcd3592b9b0fd174d7_canarc.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bca0c4677d495e67c8_jerrick.jpg"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bccd83d93c9121df05_delphx.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bc364c51458fcd940c_eastman.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bc6a529b91cf471cae_zecotek.jpg"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bc151b6725c53ea7ba_vandiam-corp.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bc372a80a14ec93ed9_Untitled-1.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bcdb09923269979d9c_aurora-1.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bc956a12794b47fbab_ths.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bc1b804dd38886f67f_phivida.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bc8ea6ca760f3c989f_xebec.jpg"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bcb6f7edca9f48887b_quantam.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bdb6f7edca9f488881_cpt125442696.jpg"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bdd173b9a1a7c65201_jenex.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bd5580f7f11ae331d3_download.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bd5d1ad184feac6316_cotinga.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bc43c652145d2f1497_gungnir.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bcb81bbe1f7d1aa1cb_nxgold.png"/></div><div class="single-logo"><img alt="" class="single-logo-img" loading="lazy" src="/images/68ca49bd3b69569cafc9b03a_t1.png"/></div></div><div class="buttons-row center mt-50 reveal-on-scroll"><a class="btn-primary w-button" href="#">Get in touch<span class="line-rounded-icon link-icon-right"></span></a></div></div></div>

<script>
  const slider = document.querySelector<HTMLElement>('.timeline-slider');
  if (slider) {
    const mask = slider.querySelector<HTMLElement>('.w-slider-mask');
    const slides = Array.from(slider.querySelectorAll<HTMLElement>('.w-slide'));
    const prevBtn = slider.querySelector<HTMLElement>('.w-slider-arrow-left');
    const nextBtn = slider.querySelector<HTMLElement>('.w-slider-arrow-right');
    const dotsContainer = slider.querySelector<HTMLElement>('.w-slider-nav');

    let currentIndex = 0;

    if (mask) {
      mask.style.display = 'flex';
      mask.style.overflow = 'hidden';
    }
    slides.forEach((slide) => {
      slide.style.transition = 'transform 0.5s ease';
    });

    const getVisibleCount = () => {
      if (window.innerWidth < 768) return 1;
      if (window.innerWidth < 992) return 2;
      return 3;
    };

    const renderDots = () => {
      if (!dotsContainer) return;
      dotsContainer.innerHTML = '';
      slides.forEach((_, idx) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.ariaLabel = `Go to slide ${idx + 1}`;
        dot.className = `w-slider-dot${idx === currentIndex ? ' w-active' : ''}`;
        dot.addEventListener('click', () => goTo(idx));
        dotsContainer.appendChild(dot);
      });
    };

    const updateSlider = () => {
      const visible = getVisibleCount();
      const maxIndex = Math.max(0, slides.length - visible);
      if (currentIndex > maxIndex) currentIndex = 0;
      if (currentIndex < 0) currentIndex = maxIndex;
      slides.forEach((slide) => {
        slide.style.transform = `translateX(-${currentIndex * 100}%)`;
      });
      if (dotsContainer) {
        dotsContainer.querySelectorAll('.w-slider-dot').forEach((dot, idx) => {
          dot.classList.toggle('w-active', idx === currentIndex);
        });
      }
    };

    const goTo = (idx: number) => {
      currentIndex = idx;
      updateSlider();
    };

    prevBtn?.addEventListener('click', () => {
      const visible = getVisibleCount();
      const maxIndex = Math.max(0, slides.length - visible);
      currentIndex = currentIndex <= 0 ? maxIndex : currentIndex - 1;
      updateSlider();
    });

    nextBtn?.addEventListener('click', () => {
      const visible = getVisibleCount();
      const maxIndex = Math.max(0, slides.length - visible);
      currentIndex = currentIndex >= maxIndex ? 0 : currentIndex + 1;
      updateSlider();
    });

    renderDots();
    updateSlider();
    window.addEventListener('resize', updateSlider);
  }
</script>
</Layout>
