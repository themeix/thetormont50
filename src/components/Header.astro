---
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Process', href: '/process' },
  { label: 'Services', href: '/services' },
  { label: 'Leadership', href: '/leadership' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="header-wrapper w-nav" role="banner">
  <div class="container-default w-container">
    <div class="header-content-wrapper">
      <a
        href="/"
        class:list={['header-logo-link w-nav-brand', currentPath === '/' && 'w--current']}
        aria-current={currentPath === '/' ? 'page' : undefined}
      >
        <img
          src="/images/68c953f29fc3e99eb7ef6793_Tormont-50-logo-.png"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          alt="The Tormont 50 logo"
        />
      </a>

      <div class="header-right-side">
        <nav role="navigation" class="header-nav-menu-wrapper w-nav-menu" data-nav-menu>
          <ul role="list" class="header-nav-menu-list">
            {
              navItems.map((item) => {
                const isActive = currentPath === item.href;
                return (
                  <li class="header-nav-list-item">
                    <a
                      href={item.href}
                      class:list={['header-nav-link w-nav-link', isActive && 'w--current']}
                      aria-current={isActive ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>

        <button
          type="button"
          class="hamburger-menu-wrapper w-nav-button border-0 bg-transparent cursor-pointer"
          data-mobile-toggle
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <div class="hamburger-menu-bar top"></div>
          <div class="hamburger-menu-bar bottom"></div>
        </button>
      </div>
    </div>
  </div>
</header>
