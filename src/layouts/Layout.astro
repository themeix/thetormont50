---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'The Tormont 50 is redefining institutional markets & capital advisory with bespoke research, strategic advisory, and capital formation.',
  ogImage = '/images/68d00645161115b0793e8d90_68ca4d61c97263630e0a65a9_the-tormont-50.jpg',
  bodyClass = '',
  noindex = false,
  schema,
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? 'https://thetormont50.com';
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageUrl = new URL(ogImage, siteOrigin).href;

const baseOrganization = {
  '@type': ['Organization', 'ProfessionalService'],
  '@id': `${siteOrigin}/#organization`,
  name: 'The Tormont 50',
  alternateName: 'Tormont 50',
  url: siteOrigin,
  logo: {
    '@type': 'ImageObject',
    url: `${siteOrigin}/images/68c953f29fc3e99eb7ef6793_Tormont-50-logo-.png`,
  },
  email: 'info@tormontgroup.com',
  sameAs: ['https://www.linkedin.com/company/thetormont50page/'],
  description:
    'A consultancy group built for boards, CEOs, and investors. We create alignment, resolve disconnects, and design strategies that build long-term shareholder trust and value.',
};

const baseWebsite = {
  '@type': 'WebSite',
  '@id': `${siteOrigin}/#website`,
  url: siteOrigin,
  name: 'The Tormont 50',
  publisher: { '@id': `${siteOrigin}/#organization` },
  inLanguage: 'en',
};

const extraSchemas = Array.isArray(schema) ? schema : schema ? [schema] : [];
const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [baseOrganization, baseWebsite, ...extraSchemas],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:site_name" content="The Tormont 50" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link
      rel="preload"
      href="/fonts/68c878e01b5edefb6e67af5c_Mona-Sans-Bold.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/68c878e01b5edefb6e67af5d_Mona-Sans-Medium.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <link
      href="/images/68cffdd706f3e37df7353440_favicon-1-1.png"
      rel="shortcut icon"
      type="image/x-icon"
    />
    <link
      href="/images/68cffdbd3f158f07fb8a5b1a_favicon-1.png"
      rel="apple-touch-icon"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
  </head>
  <body class={bodyClass}>
    <div class="page-wrapper">
      <Header />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      // Mobile navigation toggle
      const hamburger = document.querySelector<HTMLElement>('[data-mobile-toggle]');
      const navMenu = document.querySelector<HTMLElement>('[data-nav-menu]');
      if (hamburger && navMenu) {
        hamburger.addEventListener('click', () => {
          const isOpen = navMenu.classList.toggle('is-open');
          hamburger.classList.toggle('is-open', isOpen);
          hamburger.setAttribute('aria-expanded', String(isOpen));
        });
      }

      // GSAP + ScrollTrigger animations
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        gsap.registerPlugin(ScrollTrigger);

        // Hero entrance
        const heroShapes = document.querySelectorAll('.top-section .grid-shape-wrapper .shape');
        if (heroShapes.length) {
          gsap.from(heroShapes, {
            scale: 0.9,
            opacity: 0,
            duration: 0.65,
            stagger: 0.04,
            ease: 'power3.out',
            clearProps: 'transform,opacity',
          });
        }

        const heroText = document.querySelectorAll(
          '.top-section h1, .top-section .grid-2-columns.hero-v1 p, .top-section .grid-2-columns.hero-v1 .buttons-row'
        );
        if (heroText.length) {
          gsap.from(heroText, {
            y: 20,
            opacity: 0,
            duration: 0.65,
            stagger: 0.08,
            ease: 'power3.out',
            clearProps: 'transform,opacity',
          });
        }

        // Scroll-triggered section & card reveals
        const revealEls = gsap.utils.toArray<HTMLElement>('.reveal-on-scroll');
        revealEls.forEach((el) => {
          // Skip hero shapes already animated above
          if (el.closest('.top-section .grid-shape-wrapper')) return;
          gsap.from(el, {
            y: 22,
            opacity: 0,
            duration: 0.65,
            ease: 'power3.out',
            clearProps: 'transform,opacity',
            scrollTrigger: {
              trigger: el,
              start: 'top 88%',
              once: true,
            },
          });
        });

        // Staggered service / feature cards
        document.querySelectorAll('.grid-3-columns').forEach((grid) => {
          const cards = grid.children;
          if (cards.length) {
            gsap.from(cards, {
              y: 24,
              opacity: 0,
              duration: 0.55,
              stagger: 0.08,
              ease: 'power2.out',
              clearProps: 'transform,opacity',
              scrollTrigger: {
                trigger: grid,
                start: 'top 85%',
                once: true,
              },
            });
          }
        });

        // Staggered partner logos
        const logos = document.querySelectorAll('.logo-grid .single-logo');
        if (logos.length) {
          gsap.from(logos, {
            y: 14,
            opacity: 0,
            duration: 0.4,
            stagger: { amount: 0.5, from: 'start' },
            ease: 'power2.out',
            clearProps: 'transform,opacity',
            scrollTrigger: {
              trigger: '.logo-grid',
              start: 'top 88%',
              once: true,
            },
          });
        }
      }
    </script>
  </body>
</html>
