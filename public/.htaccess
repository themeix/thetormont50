# Serve index.html for directory requests
DirectoryIndex index.html
DirectorySlash On

# Use Astro's generated 404 page
ErrorDocument 404 /404.html

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Ensure directory requests without trailing slash redirect cleanly to trailing slash
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

# Remove trailing .html if someone links to it
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# Long-term caching for hashed assets (Astro _astro/* files are content-hashed)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
</IfModule>

# Never cache HTML so deploys show up immediately
<FilesMatch "\.html$">
  <IfModule mod_expires.c>
    ExpiresDefault "access plus 0 seconds"
  </IfModule>
</FilesMatch>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
